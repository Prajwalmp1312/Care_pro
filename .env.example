# Copy this file to .env before running docker compose.
MYSQL_ROOT_PASSWORD=change-this-database-password

# CareConnect signs the patient token used by healthcare and meal-planning routes.
CARECONNECT_SECRET_KEY=replace-with-at-least-48-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=careconnect-api
JWT_AUDIENCE=careconnect-web
REQUIRE_EMAIL_VERIFICATION=false
# Docker routes API traffic through the bundled Nginx proxy. Set this to false
# if FastAPI is exposed directly or the upstream proxy is not trusted.
TRUST_PROXY_HEADERS=true
MEDICAL_UPLOAD_MAX_MB=20
CHAT_UPLOAD_MAX_MB=10
COMM360_BASE_URL=https://comm360.feeltiptop.com/
APPOINTMENT_TIMEZONE=America/Los_Angeles
API_RATE_LIMIT_PER_MINUTE=600
# Required when the API runs with multiple workers or replicas.
REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=care360:rate-limit
REQUIRE_SHARED_RATE_LIMITER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
# Enable this on one scheduler deployment only when API replicas are scaled.
RUN_BACKGROUND_SCHEDULERS=true
ENABLE_API_DOCS=true

# Optional AI services. The applications retain curated fallbacks when omitted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_VISION_API_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# Optional Google sign-in.
GOOGLE_CLIENT_ID=

# Optional email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
MAILJET_API_KEY=
MAILJET_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=CareConnect Pro

# Optional initial admin. Leave blank to skip automatic creation.
DEFAULT_ADMIN_NAME="CareConnect Admin"
DEFAULT_ADMIN_EMAIL=admin@careconnect.com
DEFAULT_ADMIN_PASSWORD=Admin@123
