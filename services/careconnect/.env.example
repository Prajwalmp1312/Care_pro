DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careconnect_pro
DB_SSL_CA=

SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
JWT_ISSUER=careconnect-api
JWT_AUDIENCE=careconnect-web
REQUIRE_EMAIL_VERIFICATION=false
TRUST_PROXY_HEADERS=false
MEDICAL_UPLOAD_MAX_MB=20
CHAT_UPLOAD_MAX_MB=10
COMM360_BASE_URL=https://comm360.feeltiptop.com/
APPOINTMENT_TIMEZONE=America/Los_Angeles
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_API_DOCS=true
API_RATE_LIMIT_PER_MINUTE=600
REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=care360:rate-limit
REQUIRE_SHARED_RATE_LIMITER=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
RUN_BACKGROUND_SCHEDULERS=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_SECONDS=0.75
USE_GEMINI_HEALTH_TIPS=false
GOOGLE_CLIENT_ID=
CHROMA_DB_PATH=./chroma_db
CHROMA_EMBEDDING_CACHE_PATH=./chroma_cache
RAG_RETRY_COOLDOWN_SECONDS=300

DEFAULT_ADMIN_NAME=CareConnect Admin
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
MAILJET_API_KEY=
MAILJET_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=CareConnect Pro
